#!/bin/bash
set -euo pipefail

# ==================================================================
# Настройки (можно переопределить через переменные окружения)
# ==================================================================
PGDATA="${PGDATA:-/var/lib/postgresql/17/main}"
PG_BIN="${PG_BIN:-/usr/lib/postgresql/17/bin}"
PG_USER="${POSTGRES_USER:-postgres}"
PG_DB="${POSTGRES_DB:-}"
PG_PASSWORD="${POSTGRES_PASSWORD:-postgres}"
TEMPLATE="/etc/postgresql/17/main/postgresql.conf.template"

# Флаги поведения
ALLOW_REINIT="${ALLOW_REINIT:-0}"              # 1 = разрешить переинициализацию битого кластера
WALG_RESTORE="${WALG_RESTORE:-0}"              # 1 = восстановить из WAL-G
WALG_ARCHIVE="${WALG_ARCHIVE:-0}"              # 1 = включить архивацию WAL-G (по умолчанию ВЫКЛ!)
WALG_RESTORE_STRIP="${WALG_RESTORE_STRIP:-0}"  # 1 = --strip-components=1 при распаковке tar
FORCE_CONFIG_TEMPLATE="${FORCE_CONFIG_TEMPLATE:-0}"  # 1 = применить шаблон даже поверх restored-кластера

RESTORE_MARKER="${PGDATA}/.walg-restored"

LOG_PREFIX="[entrypoint]"
log()  { echo "${LOG_PREFIX} $*"; }
die()  { echo "${LOG_PREFIX} FATAL: $*" >&2; exit 1; }

# ==================================================================
# 0. Санити-чеки
# ==================================================================
[ -x "${PG_BIN}/initdb" ]   || die "initdb не найден в ${PG_BIN}"
[ -x "${PG_BIN}/pg_ctl" ]   || die "pg_ctl не найден в ${PG_BIN}"
[ -x "${PG_BIN}/postgres" ] || die "postgres не найден в ${PG_BIN}"

if [ "$(id -u)" = "0" ]; then
    die "entrypoint.sh нельзя запускать от root. Запускайте от пользователя postgres."
fi

# ==================================================================
# 1. Подготовка переменных для шаблона конфига
#    По умолчанию ВСЁ, что связано с WAL-G-архивацией, выключено.
#    Включается только при WALG_ARCHIVE=1.
# ==================================================================
prepare_config_vars() {
    if [ "${WALG_ARCHIVE}" = "1" ]; then
        log ">>> WALG_ARCHIVE=1 — включаю архивацию WAL через WAL-G."
        export PG_ARCHIVE_MODE="on"
        export PG_ARCHIVE_COMMAND="wal-g wal-push %p"
        export PG_RESTORE_COMMAND="wal-g wal-fetch %f %p"
    else
        log ">>> WALG_ARCHIVE не задан — архивация WAL отключена (archive_mode=off)."
        export PG_ARCHIVE_MODE="off"
        export PG_ARCHIVE_COMMAND="/bin/true"
        export PG_RESTORE_COMMAND="/bin/true"
    fi
    export PG_ARCHIVE_TIMEOUT="${PG_ARCHIVE_TIMEOUT:-60}"
}

# ==================================================================
# 2. Проверка валидности кластера
# ==================================================================
cluster_is_valid() {
    [ -s "${PGDATA}/PG_VERSION" ]      || return 1
    [ -s "${PGDATA}/pg_hba.conf" ]     || return 1
    [ -s "${PGDATA}/postgresql.conf" ] || return 1
    [ -d "${PGDATA}/base" ]            || return 1
    [ -d "${PGDATA}/global" ]          || return 1
    [ -d "${PGDATA}/pg_wal" ]          || return 1
    return 0
}

# ==================================================================
# 3. Проверка прав
# ==================================================================
check_permissions() {
    if [ -e "${PGDATA}" ]; then
        local owner
        owner="$(stat -c '%U' "${PGDATA}" 2>/dev/null || echo '?')"
        if [ "${owner}" != "$(id -un)" ]; then
            die "PGDATA=${PGDATA} принадлежит '${owner}', а мы работаем от '$(id -un)'. Исправьте права или удалите том."
        fi
    fi
}

# ==================================================================
# 4. Восстановление из WAL-G (с поддержкой tar.br)
# ==================================================================
restore_from_walg() {
    log ">>> Режим восстановления из WAL-G (WALG_RESTORE=1)"

    [ -n "${WALG_STORAGE_PREFIX:-}" ] || die "WALG_STORAGE_PREFIX не задан"
    command -v wal-g  >/dev/null || die "wal-g не найден в PATH"
    command -v brotli >/dev/null || die "brotli не найден в PATH (нужен для распаковки .br)"
    command -v tar    >/dev/null || die "tar не найден в PATH"

    mkdir -p "${PGDATA}"
    chmod 700 "${PGDATA}"
    if [ -n "$(ls -A "${PGDATA}" 2>/dev/null || true)" ]; then
        die "PGDATA=${PGDATA} не пуст. Очистите том перед восстановлением."
    fi

    # Как WAL-G должен распаковывать поток
    if [ "${WALG_RESTORE_STRIP}" = "1" ]; then
        log ">>> Использую --strip-components=1 (архив содержит подкаталог)"
        export WALG_STREAM_RESTORE_COMMAND="brotli -d -c | tar -xf - -C ${PGDATA} --strip-components=1"
    else
        export WALG_STREAM_RESTORE_COMMAND="brotli -d -c | tar -xf - -C ${PGDATA}"
    fi

    local backup_name="${WALG_BACKUP_NAME:-LATEST}"
    log ">>> wal-g backup-fetch ${backup_name}"
    wal-g backup-fetch "${PGDATA}" "${backup_name}"

    # recovery.signal — для PostgreSQL 12+
    touch "${PGDATA}/recovery.signal"

    # ------------------------------------------------------------------
    # КРИТИЧНО: в postgresql.auto.conf пишем настройки, которые
    # перекрывают всё, что могло прийти из бэкапа.
    # В частности — принудительно ВЫКЛЮЧАЕМ архивацию, чтобы после
    # promote восстановленный кластер не начал пушить WAL обратно
    # в бэкап-репозиторий и не испортил его.
    # ------------------------------------------------------------------
    {
        echo "# --- Сгенерировано entrypoint.sh при восстановлении ---"
        echo "archive_mode = off"
        echo "archive_command = ''"
        echo "restore_command = 'wal-g wal-fetch %f %p'"
        echo "recovery_target_timeline = 'latest'"
        if [ -n "${WALG_RECOVERY_TARGET_TIME:-}" ]; then
            echo "recovery_target_time = '${WALG_RECOVERY_TARGET_TIME}'"
        fi
        echo "recovery_target_action = 'promote'"
        echo "listen_addresses = '*'"
    } >> "${PGDATA}/postgresql.auto.conf"

    # Маркер: кластер восстановлен, шаблон конфига поверх не применять
    touch "${RESTORE_MARKER}"

    log ">>> Восстановление завершено. Архивация WAL принудительно выключена."
}

# ==================================================================
# 5. Инициализация кластера
# ==================================================================
init_cluster() {
    log ">>> Инициализация кластера PostgreSQL в ${PGDATA}..."
    mkdir -p "${PGDATA}"
    chmod 700 "${PGDATA}"

    local pwfile
    pwfile="$(mktemp)"
    # shellcheck disable=SC2064
    trap "rm -f '${pwfile}'" RETURN
    printf '%s\n' "${PG_PASSWORD}" > "${pwfile}"

    "${PG_BIN}/initdb" \
        --username="${PG_USER}" \
        --pwfile="${pwfile}" \
        --auth-local=trust \
        --auth-host=scram-sha-256 \
        --encoding=UTF8 \
        --locale=en_US.UTF-8 \
        -D "${PGDATA}"

    log ">>> Инициализация завершена."
}

# ==================================================================
# 6. Применение шаблона postgresql.conf
# ==================================================================
apply_config_template() {
    if [ ! -f "${TEMPLATE}" ]; then
        log ">>> Шаблон ${TEMPLATE} не найден, оставляю конфиг от initdb."
        return 0
    fi

    if [ -f "${PGDATA}/postgresql.conf" ]; then
        cp -a "${PGDATA}/postgresql.conf" "${PGDATA}/postgresql.conf.bak" || true
    fi

    log ">>> Применяю шаблон конфига ${TEMPLATE}"
    envsubst '${PG_ARCHIVE_MODE} ${PG_ARCHIVE_TIMEOUT} ${PG_ARCHIVE_COMMAND} ${PG_RESTORE_COMMAND}' \
        < "${TEMPLATE}" > "${PGDATA}/postgresql.conf"

    [ -s "${PGDATA}/postgresql.conf" ] || die "postgresql.conf получился пустым после envsubst"
}

# ==================================================================
# 7. Создание БД (если нужно)
# ==================================================================
ensure_database() {
    [ -n "${PG_DB}" ] || { log ">>> POSTGRES_DB не задан, пропускаю создание БД."; return 0; }

    log ">>> Проверяю наличие БД '${PG_DB}'..."
    if "${PG_BIN}/psql" -U "${PG_USER}" -d postgres -tAc \
         "SELECT 1 FROM pg_database WHERE datname='${PG_DB}'" | grep -q 1; then
        log ">>> БД '${PG_DB}' уже существует."
        return 0
    fi

    log ">>> Создаю БД '${PG_DB}'..."
    "${PG_BIN}/createdb" -U "${PG_USER}" "${PG_DB}"
}

# ==================================================================
# 8. Временный запуск / остановка
# ==================================================================
start_temp() {
    "${PG_BIN}/pg_ctl" -D "${PGDATA}" \
        -o "-c config_file=${PGDATA}/postgresql.conf -c listen_addresses=''" \
        -w -t 60 start

    local i=0
    until "${PG_BIN}/pg_isready" -q -h /var/run/postgresql -U "${PG_USER}" ; do
        i=$((i+1))
        [ "$i" -lt 60 ] || die "PostgreSQL не поднялся за 60 секунд"
        sleep 1
    done
}

stop_temp() {
    "${PG_BIN}/pg_ctl" -D "${PGDATA}" -m fast -w -t 60 stop || true
}

# ==================================================================
# 9. Обработка сигналов
# ==================================================================
on_signal() {
    log ">>> Получен сигнал, останавливаю PostgreSQL..."
    "${PG_BIN}/pg_ctl" -D "${PGDATA}" -m fast -w -t 60 stop || true
    exit 0
}

# ==================================================================
# Основной сценарий
# ==================================================================
check_permissions
prepare_config_vars

mkdir -p /var/run/postgresql 2>/dev/null || true

# --- A. Восстановление или инициализация ---
if [ "${WALG_RESTORE}" = "1" ]; then
    restore_from_walg
elif cluster_is_valid; then
    log ">>> Найден валидный кластер в ${PGDATA}, инициализация не требуется."
else
    if [ -e "${PGDATA}/PG_VERSION" ]; then
        if [ "${ALLOW_REINIT}" = "1" ]; then
            log ">>> Кластер неполный, ALLOW_REINIT=1 — переинициализирую."
            rm -rf "${PGDATA:?}"/*
            init_cluster
        else
            die "Кластер в ${PGDATA} неполный. Удалите том или запустите с ALLOW_REINIT=1."
        fi
    else
        init_cluster
    fi
fi

# --- B. Применяем шаблон конфига ---
# Не применяем шаблон, если:
#   - мы только что восстановились (маркер .walg-restored), или
#   - уже есть маркер восстановления от предыдущего запуска,
#     и пользователь явно не потребовал обратного (FORCE_CONFIG_TEMPLATE=1).
if [ "${WALG_RESTORE}" = "1" ]; then
    log ">>> Режим восстановления: шаблон конфига не применяю."
elif [ -f "${RESTORE_MARKER}" ] && [ "${FORCE_CONFIG_TEMPLATE}" != "1" ]; then
    log ">>> Обнаружен маркер восстановления (${RESTORE_MARKER}) — шаблон конфига не применяю."
    log ">>> Архивация WAL остаётся выключенной (см. postgresql.auto.conf)."
else
    apply_config_template
fi

# --- C. Временный запуск и создание БД ---
if [ "${WALG_RESTORE}" != "1" ]; then
    start_temp
    ensure_database
    stop_temp
else
    log ">>> В режиме восстановления создание БД пропущено — БД берутся из бэкапа."
fi

# --- D. Основной запуск ---
trap on_signal SIGTERM SIGINT SIGQUIT

log ">>> Запуск PostgreSQL (foreground)..."
exec "${PG_BIN}/postgres" -D "${PGDATA}" -c config_file="${PGDATA}/postgresql.conf"
